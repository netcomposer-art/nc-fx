{
  "name": "@netcomposer/nc-fx",
  "version": "0.1.0",
  "description": "NetComposer's shared effects for instruments and the Studio: ASTRID's whole Hacks catalog (drive, delay, reverb, EQ, compressor, width, flanger, chorus, phaser, filters) as a fixed chain or ASTRID's movable slots, framework-free Web Audio, with an optional nc-ui kit panel, and insert plugins: a manifest plus one AudioWorklet DSP file, loaded from a URL, with a checker (nc-fx-check).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Peter Semmelhack (https://psem.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netcomposer-art/nc-fx.git"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dsp": {
      "types": "./src/dsp.d.ts",
      "default": "./src/dsp.js"
    },
    "./chain": {
      "types": "./src/chain.d.ts",
      "default": "./src/chain.js"
    },
    "./catalog": {
      "types": "./src/catalog.d.ts",
      "default": "./src/catalog.js"
    },
    "./eq": {
      "types": "./src/eq.d.ts",
      "default": "./src/eq.js"
    },
    "./slots": {
      "types": "./src/slots.d.ts",
      "default": "./src/slots.js"
    },
    "./gate": {
      "types": "./src/gate.d.ts",
      "default": "./src/gate.js"
    },
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.js"
    },
    "./plugin-worklet": {
      "types": "./src/plugin-worklet.d.ts"
    },
    "./params": {
      "types": "./src/params.d.ts",
      "default": "./src/params.js"
    },
    "./tempo": {
      "types": "./src/tempo.d.ts",
      "default": "./src/tempo.js"
    },
    "./ui": {
      "types": "./src/ui.d.ts",
      "default": "./src/ui.js"
    },
    "./ui.css": "./dist/ui.css",
    "./worklet": "./dist/worklet.js",
    "./worklet.js": "./dist/worklet.js",
    "./worklet-source": {
      "types": "./src/worklet-source.d.ts",
      "default": "./dist/worklet-source.js"
    },
    "./schema/plugin-manifest.schema.json": "./schema/plugin-manifest.schema.json",
    "./schema/plugin-registry.schema.json": "./schema/plugin-registry.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "schema",
    "docs",
    "scripts/check-plugin.mjs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --expose-gc test/*.test.mjs && node --test test/checker/*.test.mjs",
    "test:browser": "node test/browser/run.mjs",
    "size": "node scripts/size.mjs",
    "check-plugin": "node scripts/check-plugin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "~5.9.3"
  },
  "bin": {
    "nc-fx-check": "scripts/check-plugin.mjs"
  }
}
