{
  "ncPlugin": 1,
  "id": "test.throws",
  "name": "Bad throws",
  "version": "1.0.0",
  "author": "Peter Semmelhack",
  "licence": "MIT",
  "description": "The level goes up and down. Rate, depth and shape.",
  "website": "https://github.com/netcomposer-art/nc-plugin-template",
  "keywords": [
    "tremolo",
    "modulation"
  ],
  "dsp": "bad.dsp.js",
  "params": [
    {
      "id": "rate",
      "label": "Rate",
      "type": "float",
      "minValue": 0.1,
      "maxValue": 20,
      "defaultValue": 5,
      "discreteStep": 0.1,
      "units": "Hz"
    },
    {
      "id": "depth",
      "label": "Depth",
      "type": "float",
      "minValue": 0,
      "maxValue": 100,
      "defaultValue": 50,
      "discreteStep": 1,
      "units": "%"
    },
    {
      "id": "shape",
      "label": "Shape",
      "type": "choice",
      "choices": [
        "Sine",
        "Triangle",
        "Square"
      ],
      "defaultValue": 0
    }
  ]
}